# ======================= MENU ========================

show_menu() {
    clear
    logo
    echo -e "${BOLD}Versión ${VERSION} | Desarrollado por ${AUTHOR}${RESET}\n"

    echo "==============================================="
    echo "                MENÚ PRINCIPAL"
    echo "==============================================="
    echo
    echo "1) Auditoría SSH"
    echo "2) Información del sistema"
    echo "3) Comprobación de integridad"
    echo "4) Escaneo Nmap"
    echo "5) Rootkit Hunter"
    echo "6) Aplicar Hardening"
    echo "7) Revertir Hardening"
    echo "0) Salir"
}

execute_option() {
    case "$1" in
        1) loading; sudo bash "$TOOL_PATH/audit_ssh.sh" ;;
        2) loading; sudo bash "$TOOL_PATH/sysinfo.sh" ;;
        3) loading; sudo bash "$TOOL_PATH/integrity_check.sh" ;;
        4) loading; sudo bash "$TOOL_PATH/scan_nmap.sh" ;;
        5) loading; sudo bash "$TOOL_PATH/run_rootscan.sh" ;;
        6) loading; sudo bash "$TOOL_PATH/hardening.sh" ;;
        7) loading; sudo bash "$TOOL_PATH/revert.sh" ;;
        0) echo "Saliendo..."; exit 0 ;;
        *) echo "Opción inválida" ;;
    esac
}

# ======================= LOOP PRINCIPAL ========================

while true; do
    show_menu
    echo -ne "${BLUE}${BOLD}Selecciona una opción: ${RESET}"
    read option
    execute_option "$option"
    echo
    echo "Presiona ENTER para continuar..."
    read
done
