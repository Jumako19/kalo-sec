#!/bin/bash

# ======================= COLORES ========================
BLUE="\033[34m"
RESET="\033[0m"
BOLD="\033[1m"

# ======================= RUTAS ========================
TOOL_PATH="/usr/share/kalo-sec/tools"
DOCS_PATH="/opt/kalo-sec/docs"

VERSION="1.0"
AUTHOR="Jumako19"

# ======================= ANIMACIONES ========================

typewriter() {
    text="$1"
    speed=${2:-0.002}
    for ((i=0; i<${#text}; i++)); do
        printf "%s" "${text:i:1}"
        sleep "$speed"
    done
    echo
}

loading() {
    chars='/-\|'
    for i in {1..20}; do
        for ((j=0; j<${#chars}; j++)); do
            echo -en "\rCargando... ${chars:j:1}"
            sleep 0.1
        done
    done
    echo -e "\rListo!            "
}

# ======================= LOGO ========================

logo() {
echo -e "${BLUE}${BOLD}"
cat << "EOF"
