#!/bin/bash

# ======================= COLORES ========================
RED="\033[31m"
#GREEN="\033[32m"
#YELLOW="\033[33m"
BLUE="\033[34m"
CYAN="\033[36m"
#MAGENTA="\033[35m"
RESET="\033[0m"
BOLD="\033[1m"

# RUTA CORRECTA A TUS SCRIPTS
TOOL_PATH="/usr/share/kalo-sec/tools"
DOCS_PATH="/opt/kalo-sec/docs"

VERSION="1.0"
AUTHOR="Jumako19"

# ======================= ANIMACIONES ========================

typewriter() {
    text="$1"
    speed=${2:-0.002}
    for ((i=0; i<${#text}; i++)); do
        echo -n "${text:$i:1}"
        sleep $speed   
 done
    echo
}

loading() {
    chars="/—\|"
    for i in {1..20}; do
        for (( j=0; j<${#chars}; j++ )); do
            echo -en "\r${YELLOW}Cargando... ${chars:$j:1}"
            sleep 0.1
        done
    done
    echo -e "\r${YELLOW}Listo!              ${RESET}"
}

# ======================= LOGO ========================

logo() {
echo -e "$BLUE}"
cat << "EOF"
