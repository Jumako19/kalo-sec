# ======================= MENU ========================

show_menu() {
    clear
    logo
    typewriter "${YELLOW}Versión ${VERSION} | Desarrollado por ${AUTHOR}" 0.003

    echo -e "${YELLOW}"
    echo "==============================================="
    echo "                MENÚ PRINCIPAL"
    echo "==============================================="
    echo -e "${RESET}"

    echo -e "${YELLOW}1)${RESET} Auditoría SSH"
    echo -e "${YELLOW}2)${RESET} Información del sistema"
    echo -e "${YELLOW}3)${RESET} Comprobación de integridad"
    echo -e "${YELLOW}4)${RESET} Escaneo Nmap"
    echo -e "${YELLOW}5)${RESET} Rootkit Hunter"
    echo -e "${YELLOW}6)${RESET} Aplicar Hardening"
    echo -e "${YELLOW}7)${RESET} Revertir Hardening"
    echo -e "${YELLOW}0)${RESET} Salir"
}

execute_option() {
    case $1 in
        1) loading; sudo bash "$TOOL_PATH/audit_ssh.sh" ;;
        2) loading ;sudo bash "$TOOL_PATH/sysinfo.sh" ;;
        3) loading ;sudo bash "$TOOL_PATH/integrity_check.sh" ;;
        4) loading; sudo bash "$TOOL_PATH/scan_nmap.sh" ;;
        5) loading; sudo bash "$TOOL_PATH/run_rootscan.sh" ;;
        6) loading; sudo bash "$TOOL_PATH/hardening.sh" ;;
        7) loading; sudo bash "$TOOL_PATH/revert.sh" ;;
        0) echo -e "${GREEN}Saliendo...${RESET}"; exit 0 ;;
        *) echo -e "${RED}Opción inválida${RESET}" ;;
    esac
}

# ======================= LOOP PRINCIPAL ========================

while true; do
    show_menu
    echo -ne "${BLUE}Selecciona una opción:${RESET} "
    read option
    execute_option "$option"
    echo -e "\n${BLUE}Presiona ENTER para continuar...${RESET}"
    read
done

